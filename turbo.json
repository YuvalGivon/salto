{
  "$schema": "https://turborepo.org/schema.json",
  "globalEnv": [
    "GITHUB_PAT_PACKAGES"
  ],
  "tasks": {
    "build-ts": {
      "outputLogs": "new-only",
      "outputs": ["dist/**"],
      "dependsOn": ["^build-ts"]
    },
    "lint": {
      "outputLogs": "new-only",
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.mjs", "../../eslint.config.mjs"],
      "outputs": []
    },
    "check-format": {
      "outputLogs": "new-only",
      "outputs": [".check-format.cache"]
    },
    "test": {
      "dependsOn": ["^build-ts"],
      "outputLogs": "new-only",
      "env": ["SALTO_DEPENDENCIES_HASH"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
